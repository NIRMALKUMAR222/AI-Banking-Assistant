# ============================================================
#  SecureBank RAG — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# ── LLM (Groq via OpenAI-compatible API) ────────────────────
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Backward-compatibility alias (if using xAI Grok instead)
# GROK_API_KEY=xai-your_xai_api_key_here
# GROK_MODEL=grok-beta
# GROK_BASE_URL=https://api.x.ai/v1


# ── Embeddings ────────────────────────────────────────────────
# Model downloaded automatically on first run
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ──────────────────────────────────────────────
# Options: "faiss" (default, in-memory) | "chroma" (persistent)
VECTOR_STORE_BACKEND=faiss
FAISS_INDEX_PATH=./data/faiss_index
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=securebank_docs

# ── Retrieval ─────────────────────────────────────────────────
TOP_K=5
KNOWLEDGE_BASE_DIR=./data/knowledge_base

# ── Service API Key (service-to-service / Streamlit frontend) ─
# Change this before deploying. Use a long random string.
API_KEY=securebank-dev-key-change-me

# ── JWT Authentication ────────────────────────────────────────
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE-ME-use-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────
# Set to your frontend origin(s) in production, e.g.:
# CORS_ORIGINS=https://app.securebank.com,https://admin.securebank.com
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend (Streamlit) ──────────────────────────────────────
# URL of the running FastAPI backend
API_BASE_URL=http://localhost:8000